# ── Netlify / Vite web build env (SAME for all deploy contexts) ─────────
# Copy into Netlify UI (Site configuration → Environment variables)
#   → scopes: All scopes / Same value in all deploy contexts
# OR rely on netlify.toml [build.environment] (already mirrors these).
#
# Only VITE_* keys are baked into the browser bundle.
# After any change: Deploys → Trigger deploy → Clear cache and deploy site.
#
# Local `pnpm web` uses repo-root `.env` instead (see `.env.example`).

# Toolchain (Netlify build image)
NODE_VERSION=22.23.2
PNPM_VERSION=10.33.2

# ── Required for bridge UI ─────────────────────────────────────────────
VITE_BRIDGE_FEE_RECIPIENT=0x33D5928E1c66E831Eb250D1250bf2CfF9eACa370
VITE_BRIDGE_PUBLIC_URL=https://aztec-dfarchon-kit.netlify.app/
VITE_ENABLE_BROWSER_CLAIM=true

# ── Mainnet Aztec / L1 RPC (web) ───────────────────────────────────────
VITE_MAINNET_AZTEC_NODE_URL=https://lb.drpc.live/aztec-mainnet/AnUkBxJDjUo3ksEkgPshPngqoSJzkNIR8YO-RoYgFhqK
# VITE_MAINNET_L1_RPC_URL=https://ethereum-rpc.publicnode.com

# ── Optional web ───────────────────────────────────────────────────────
VITE_DFPUNK_PLAY_URL=https://aztec.dfpunk.xyz/play/
# VITE_WALLETCONNECT_PROJECT_ID=
# VITE_BRIDGE_ETH_FEE_WEI=1000000000000000
# VITE_TESTNET_AZTEC_NODE_URL=https://v5.testnet.rpc.aztec-labs.com
# VITE_TESTNET_L1_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# VITE_MAINTENANCE_MODE=false
# VITE_SPONSORED_FPC_ADDRESS=0x1441491b59934ec64f8c98f17c91f23c01ca2a45dbb35caf123146ec76f9970c

# ── CLI / API only (not used by static Netlify web bundle) ─────────────
# Keep in Netlify UI only if you also run CLI elsewhere; harmless if present.
BRIDGE_FEE_RECIPIENT=0x33D5928E1c66E831Eb250D1250bf2CfF9eACa370
MAINNET_AZTEC_NODE_URL=https://lb.drpc.live/aztec-mainnet/AnUkBxJDjUo3ksEkgPshPngqoSJzkNIR8YO-RoYgFhqK
MAINNET_L1_RPC_URL=https://ethereum-rpc.publicnode.com
