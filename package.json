{
  "name": "df-aztec-kit",
  "version": "0.1.1",
  "private": true,
  "description": "Fee Juice L1→L2 bridge monorepo (core, CLI, API, web)",
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "scripts": {
    "preinstall": "node ./scripts/enforce-pnpm.mjs",
    "typecheck": "pnpm run build:libs && pnpm -r run typecheck",
    "build": "pnpm run build:libs && pnpm -r run build",
    "build:libs": "pnpm --filter @df-bridge/core --filter @df-bridge/browser-sdk run build",
    "cli": "pnpm --filter @df-bridge/cli run cli",
    "api": "pnpm --filter @df-bridge/api run dev",
    "web": "pnpm --filter @df-bridge/web run dev",
    "web:clean": "pnpm --filter @df-bridge/web run dev:clean",
    "deploy-l1-bridge": "node --import tsx scripts/deploy-l1-bridge.ts",
    "check:artifacts": "bash scripts/check-artifacts.sh",
    "check:pnpm": "bash scripts/check-pnpm-hardening.sh",
    "check:toolchain": "bash scripts/check-toolchain.sh",
    "test:contracts": "cd contracts/ethereum/solidity && forge test",
    "test:api": "pnpm --filter @df-bridge/api run test",
    "audit": "pnpm audit --prod"
  },
  "engines": {
    "node": "22.23.2",
    "pnpm": "10.33.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "leveldown",
      "lmdb",
      "msgpackr-extract",
      "protobufjs",
      "@reown/appkit"
    ]
  },
  "devDependencies": {
    "@df-bridge/core": "workspace:*",
    "tsx": "4.23.1",
    "typescript": "5.7.3"
  }
}
