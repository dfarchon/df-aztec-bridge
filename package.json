{
  "name": "df-aztec-bridge-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Fee Juice L1→L2 bridge monorepo (core, CLI, API, web)",
  "scripts": {
    "typecheck": "pnpm run build:libs && pnpm -r run typecheck",
    "build": "pnpm run build:libs && pnpm -r run build",
    "build:libs": "pnpm --filter @df-bridge/core --filter @df-bridge/browser-sdk run build",
    "cli": "pnpm --filter @df-bridge/cli run cli",
    "api": "pnpm --filter @df-bridge/api run dev",
    "web": "pnpm --filter @df-bridge/web run dev",
    "web:clean": "pnpm --filter @df-bridge/web run dev:clean",
    "deploy-l1-bridge": "node --import tsx scripts/deploy-l1-bridge.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@df-bridge/core": "workspace:*",
    "tsx": "^4.19.3",
    "typescript": "~5.7.3"
  }
}
