{
  "name": "df-aztec-bridge",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "description": "Ethereum to Aztec token deposit bridge",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "preinstall": "node ./scripts/enforce-pnpm.mjs",
    "dev": "pnpm --filter @df-bridge/web run dev",
    "typecheck": "pnpm run build:libs && pnpm -r run typecheck",
    "build": "pnpm run build:libs && pnpm -r run build",
    "build:libs": "pnpm --filter @df-bridge/browser-sdk run build",
    "web": "pnpm --filter @df-bridge/web run dev",
    "web:clean": "pnpm --filter @df-bridge/web run dev:clean",
    "check:artifacts": "bash scripts/check-artifacts.sh",
    "check:pnpm": "bash scripts/check-pnpm-hardening.sh",
    "audit": "pnpm audit --prod"
  },
  "devDependencies": {
    "tsx": "4.23.1",
    "typescript": "5.7.3"
  }
}
