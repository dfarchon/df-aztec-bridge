{
  "name": "@df-bridge/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/ensure-browser-sdk.mjs",
    "predev:clean": "node ../../scripts/ensure-browser-sdk.mjs",
    "dev": "vite",
    "dev:clean": "rm -rf node_modules/.vite ../../node_modules/.vite && vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aztec/bb.js": "5.1.0",
    "@df-bridge/browser-sdk": "workspace:*",
    "assert": "2.1.0",
    "hash.js": "1.1.7",
    "json-stringify-deterministic": "1.0.12",
    "lodash.chunk": "4.2.0",
    "lodash.clonedeepwith": "4.5.0",
    "lodash.times": "4.3.2",
    "msgpackr": "1.12.1",
    "qrcode.react": "4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sha3": "2.1.4",
    "viem": "2.55.4"
  },
  "devDependencies": {
    "@types/qrcode.react": "3.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vite-plugin-node-polyfills": "0.28.0",
    "vitest": "4.1.10"
  }
}
