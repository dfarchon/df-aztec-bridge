{
  "name": "@df-bridge/browser-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./claim-browser": {
      "types": "./dist/claim-browser.d.ts",
      "import": "./dist/claim-browser.js",
      "default": "./dist/claim-browser.js"
    },
    "./claim-lazy": {
      "types": "./dist/claim-lazy.d.ts",
      "import": "./dist/claim-lazy.js",
      "default": "./dist/claim-lazy.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aztec/aztec.js": "5.1.0",
    "@aztec/bb.js": "5.1.0",
    "@aztec/foundation": "5.1.0",
    "@aztec/kv-store": "5.1.0",
    "@aztec/pxe": "5.1.0",
    "@aztec/stdlib": "5.1.0",
    "@aztec/wallets": "5.1.0",
    "@walletconnect/ethereum-provider": "2.23.10",
    "idb-keyval": "6.3.0",
    "viem": "2.55.4"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "4.1.10"
  }
}
