{
  "name": "@df-bridge/browser-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./claim-browser": {
      "types": "./dist/claim-browser.d.ts",
      "import": "./dist/claim-browser.js",
      "default": "./dist/claim-browser.js"
    },
    "./claim-lazy": {
      "types": "./dist/claim-lazy.d.ts",
      "import": "./dist/claim-lazy.js",
      "default": "./dist/claim-lazy.js"
    },
    "./nulo": {
      "types": "./dist/nulo-connector.d.ts",
      "import": "./dist/nulo-connector.js",
      "default": "./dist/nulo-connector.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aztec-foundation/bb.js": "6.0.0",
    "@aztec-labs/aztec.js": "6.0.0",
    "@aztec-labs/foundation": "6.0.0",
    "@aztec-labs/kv-store": "6.0.0",
    "@aztec-labs/pxe": "6.0.0",
    "@aztec-labs/stdlib": "6.0.0",
    "@aztec-labs/wallets": "6.0.0",
    "@aztec-labs/wallet-sdk": "6.0.0",
    "@walletconnect/ethereum-provider": "2.23.10",
    "idb-keyval": "6.3.0",
    "viem": "2.55.4"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "4.1.12"
  }
}
