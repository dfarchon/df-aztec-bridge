{
  "name": "@df-bridge/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/core/types.d.ts",
      "import": "./dist/core/types.js",
      "default": "./dist/core/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@aztec/aztec.js": "5.2.0",
    "@aztec/ethereum": "5.2.0",
    "@aztec/foundation": "5.2.0",
    "@aztec/pxe": "5.2.0",
    "@aztec/stdlib": "5.2.0",
    "@aztec/wallets": "5.2.0",
    "viem": "^2.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "~5.7.3"
  },
  "engines": {
    "node": "24.12.0",
    "pnpm": "11.20.0"
  }
}
