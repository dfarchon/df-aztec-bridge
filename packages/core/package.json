{
  "name": "@df-bridge/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/core/types.d.ts",
      "import": "./dist/core/types.js",
      "default": "./dist/core/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aztec/aztec.js": "v5.0.1",
    "@aztec/ethereum": "v5.0.1",
    "@aztec/foundation": "v5.0.1",
    "@aztec/pxe": "v5.0.1",
    "@aztec/stdlib": "v5.0.1",
    "@aztec/wallets": "v5.0.1",
    "viem": "^2.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "~5.7.3"
  }
}
