# Local web dev. Copy to .env. Vite only reads VITE_* at startup.

TESTNET_AZTEC_NODE_URL=https://v5.testnet.rpc.aztec-labs.com
TESTNET_L1_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
TESTNET_L1_CHAIN_ID=11155111

MAINNET_AZTEC_NODE_URL=https://aztec-mainnet.drpc.org
MAINNET_L1_RPC_URL=https://ethereum-rpc.publicnode.com
MAINNET_L1_CHAIN_ID=1
# Never put path keys in VITE_* — Vite bakes them into the browser.

LOCAL_AZTEC_NODE_URL=http://localhost:8080
LOCAL_L1_RPC_URL=http://localhost:8545
LOCAL_L1_CHAIN_ID=31337
# ── Protocol fee (5%) — anonymous Trezor / treasury on Ethereum (L1) ──
BRIDGE_FEE_RECIPIENT=0x33D5928E1c66E831Eb250D1250bf2CfF9eACa370
VITE_BRIDGE_FEE_RECIPIENT=0x33D5928E1c66E831Eb250D1250bf2CfF9eACa370
# Mainnet only: native ETH service fee (~1 L1 tx) to the same recipient (first wallet confirm).
# Leave unset to estimate from gasPrice × 100000. Example fixed: 0.001 ETH = 1000000000000000
# VITE_BRIDGE_ETH_FEE_WEI=1000000000000000

# ── DF Aztec Sponsored FPC (L2) — Fee Juice funding target via this bridge ──
# Canonical salt-derived address (override only if you redeployed SponsoredFPC).
# Paste into the UI recipient field or use "Fund DF Sponsored FPC".
# Local-network: omit to register salt-0 SponsoredFPC from `aztec start --local-network`
# (PXE derives address at runtime). Testnet default is wired in apps/web sponsored-fpc.ts.
# VITE_SPONSORED_FPC_ADDRESS=0x05eb98543bd0ea8f48c1011c3162e057e8419363b772b9e11bd1c3b4bbef7fe1
#
# Chat fees preference: room WhitelistedFPC → player WhitelistedFPC → shared SponsoredFPC → wallet Fee Juice.
# moveJuice({ target: "<PXE or FPC 0x…>" }) — bridge + auto-claim Fee Juice into that L2 address (not transferable).

# Public bridge URL linked from Aztec-side collector docs / UI
VITE_BRIDGE_PUBLIC_URL=https://aztec-dfarchon-kit.netlify.app/
VITE_DFPUNK_PLAY_URL=https://aztec.dfpunk.xyz/play/

# Web — optional URL overrides (else baked-in public defaults in apps/web/src/config/networks.ts)
# VITE_TESTNET_AZTEC_NODE_URL=
# VITE_TESTNET_L1_RPC_URL=
# Mainnet default is https://aztec-mainnet.drpc.org (public). Keyed URLs belong in private env only.
# VITE_MAINNET_AZTEC_NODE_URL=https://aztec-mainnet.drpc.org
# VITE_MAINNET_L1_RPC_URL=

# Web — show maintenance page (skip bridge UI; set false when mainnet RPC is back)
# VITE_MAINTENANCE_MODE=true

# Web — local test of the `dev` client password + version-guard gate
# Client DevGate is defense-in-depth only. REQUIRED: Netlify visitor password on preview hosts.
# VITE_DEV_GATE=true
# Generate a unique hash (never commit plaintext; never reuse the published docs example):
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
# VITE_DEV_GATE_PASSWORD_HASH=
# Netlify visitor password is required for host lock — client gate alone is not enough.

# Web — WalletConnect Project ID (https://cloud.reown.com)
VITE_WALLETCONNECT_PROJECT_ID=

# Web — run L2 auto-claim in the browser (PXE). Heavy chunk (~tens–100MB+).
# true (default): browser PXE — static Netlify deploy is possible
VITE_ENABLE_BROWSER_CLAIM=true
