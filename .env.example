# Network preset: local | testnet | mainnet (see config/networks/*.json)
NETWORK=testnet

# Override JSON defaults (optional)
AZTEC_NODE_URL=
AZTEC_API_KEY=
L1_RPC_URL=
L1_CHAIN_ID=

# L1 signer for bridge txs (required for testnet/mainnet unless passed via CLI/API body)
L1_PRIVATE_KEY=

# API server
API_HOST=127.0.0.1
API_PORT=8787

# L1 deposit: gobridge (aztec-kit UI contract) | portal (Aztec.js only, no GoBridge deploy)
L1_BACKEND=gobridge

# Job persistence directory (API mode)
DATA_DIR=./data
