# Copy to .env. Restart Vite after changing this file.
# VITE_* is baked into the browser bundle — never put API keys there.

# Testnet Aztec node / Sepolia L1 (optional; code has defaults).
TESTNET_AZTEC_NODE_URL=
TESTNET_L1_RPC_URL=
TESTNET_L1_CHAIN_ID=

# Optional local override. Injected into `pnpm dev` only when it is a pinned public
# or loopback URL. A path key is ignored and is not written into the browser bundle.
MAINNET_AZTEC_NODE_URL=
MAINNET_L1_RPC_URL=
MAINNET_L1_CHAIN_ID=1

# Local sandbox.
LOCAL_AZTEC_NODE_URL=http://localhost:8080
LOCAL_L1_RPC_URL=http://localhost:8545
LOCAL_L1_CHAIN_ID=31337

# 5% protocol fee + mainnet ETH service fee recipient (L1).
BRIDGE_FEE_RECIPIENT=
VITE_BRIDGE_FEE_RECIPIENT=
# Mainnet ETH service fee is always gasPrice × ~1 L1 tx gas (no VITE_BRIDGE_ETH_FEE_WEI).

# Aztec L2 Sponsored FPC (Fee Juice funding target). Pinned — empty or canonical only.
VITE_SPONSORED_FPC_ADDRESS=0x1441491b59934ec64f8c98f17c91f23c01ca2a45dbb35caf123146ec76f9970c

# Public URLs shown in the UI.
VITE_BRIDGE_PUBLIC_URL=
VITE_DFPUNK_PLAY_URL=
# Optional sidebar event link; leave empty to hide it.
VITE_DF_AZTEC_EVENT_URL=

# Production/Netlify public RPC only (no path keys). Local keyed URL: MAINNET_AZTEC_NODE_URL above.
VITE_MAINNET_AZTEC_NODE_URL=
VITE_MAINNET_L1_RPC_URL=
VITE_TESTNET_AZTEC_NODE_URL=
VITE_TESTNET_L1_RPC_URL=

# Maintenance page instead of the bridge UI.
VITE_MAINTENANCE_MODE=

# Preview and branch deploys are locked by the Netlify edge function.
# Set DEV_GATE_PASSWORD (12+ characters) in the Netlify UI for those contexts.
# Do not prefix it with VITE_ — Vite would ship the value in the client bundle.
# Production (aztec-dfarchon-kit.netlify.app) and localhost are not gated.
# A Netlify visitor password is an optional extra CDN lock.

# WalletConnect Project ID from https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=

# Browser PXE auto-claim. true = in-browser (default); false needs a local API.
VITE_ENABLE_BROWSER_CLAIM=true

# In-app activity toasts. Off unless exactly true.
VITE_ENABLE_DAPP_LOG=false
