# Supply-chain hardening (pnpm@10.33.2+, CVE-2025-69264 fixed >=10.26).
# Lifecycle scripts: only packages in package.json#pnpm.onlyBuiltDependencies may build.
# Always prefer: pnpm install --frozen-lockfile (CI / Netlify / docs enforce this).
# Corepack pin: package.json#packageManager embeds sha512 hex (see tooling/TOOLCHAIN.pins).

engine-strict=true
fund=false
auto-install-peers=true

# Prefer the committed lockfile for installs when it still satisfies package.json.
prefer-frozen-lockfile=true
lockfile=true

# Fail if the running pnpm is not the packageManager pin (Corepack / action-setup).
package-manager-strict=true
# Exact version match (no floating patch within the packageManager range).
package-manager-strict-version=true

# Fail install when a dependency wanted lifecycle scripts but was not allowlisted.
strict-dep-builds=true

# Quarantine brand-new publishes (minutes). Frozen installs ignore this; updates wait.
# "Quarantine-ready" worm window: Shai-Hulud-class malware is often yanked <24h.
minimum-release-age=1440
minimum-release-age-strict=false

# Block transitive git / tarball / directory exotic deps (workspace: still allowed).
block-exotic-subdeps=true

# Reject versions whose publish trust dropped vs prior releases (OIDC/provenance).
trust-policy=no-downgrade

# HTTPS registry only (no accidental http mirrors).
registry=https://registry.npmjs.org/

# Do not hoist phantom deps into the app root.
shamefully-hoist=false

# Non-interactive module dir rebuilds when settings change (CI / agents).
confirm-modules-purge=false

# Fail commands if node_modules drifts from the lockfile.
verify-deps-before-run=error

# Re-check store tarball contents against lockfile integrity on fetch.
strict-store-pkg-content-check=true

# Keep Corepack / packageManager version management aligned with the pin.
manage-package-manager-versions=true
